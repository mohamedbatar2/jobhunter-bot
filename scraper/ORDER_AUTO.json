        "path": "kimi-order-trigger",
        "options": {}
      },
      "id": "e3a8b2c1-1234-4567-890a-b1c2d3e4f5g6",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{$json.body.message}}",
        "systemMessage": "=You are a Moroccan E-commerce Specialist. \nYour task: Extract product_name, quantity, customer_name, city, and phone.\n1. If the user speaks Darija, French, or Arabic, respond in the same language.\n2. Rule: You cannot finish until you have the Product, City, and Phone.\n3. Normalization: Always convert Moroccan cities to standard names (e.g., \"Kaza\" -> \"Casablanca\") and phones to +2126... or +2127...\n4. Tool Call: Only call the submit_order tool when you have all the data.\n5. Tone: Professional and helpful, based in Casablanca.",
        "options": {}
      },
      "id": "a1b2c3d4-5678-9012-3456-7890abcdef12",
      "name": "AI Agent",
      "type": "n8n-nodes-base.aiAgent",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "b2c3d4e5-6789-0123-4567-890abcdef123",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [550, 500]
    },
    {
      "parameters": {
        "sessionId": "={{$node[\"Webhook\"].json[\"body\"][\"from\"]}}",
        "databaseName": "admin",
        "collectionName": "n8n_chat_histories"
      },
      "id": "c3d4e5f6-7890-1234-5678-90abcdef1234",
      "name": "MongoDB Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryChatLogMongoDb",
      "typeVersion": 1,
      "position": [750, 500]
    },
    {
      "parameters": {
        "name": "submit_order",
        "description": "Call this tool ONLY when you have the product name, the city, and a valid phone number to finalize the order.",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"product_name\": { \"type\": \"string\" },\n    \"city\": { \"type\": \"string\" },\n    \"phone\": { \"type\": \"string\" },\n    \"customer_name\": { \"type\": \"string\" }\n  },\n  \"required\": [\"product_name\", \"city\", \"phone\"]\n}"
      },
      "id": "d4e5f6g7-8901-2345-6789-0abcdef12345",
      "name": "Submit Order Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1,
      "position": [950, 450]
    },
    {
      "parameters": {
        "jsCode": "const { product_name, city, phone, customer_name } = $json;\n\n// Phone Normalization for Morocco\nlet p = phone.replace(/\\D/g, '');\nif (p.startsWith('0')) p = '212' + p.substring(1);\nif (!p.startsWith('212')) p = '212' + p;\n\nreturn {\n  product: product_name.toUpperCase(),\n  city: city.charAt(0).toUpperCase() + city.slice(1),\n  phone: '+' + p,\n  name: customer_name || \"Client\",\n  confirmed_at: new Date().toLocaleString('fr-FR', { timeZone: 'Africa/Casablanca' })\n};"
      },
      "id": "f6g7h8i9-0123-4567-890a-bcdef1234567",
      "name": "Normalization Logic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [1150, 450]
    }
  ],
